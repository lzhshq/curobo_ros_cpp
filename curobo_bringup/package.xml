  <version>0.7.1</version>
  <description>Robot descriptors and the combined cuRobo planner/executor/RViz launch.</description>
  <maintainer email="384336014@qq.com">lzhshq</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>curobo_planner_interfaces</test_depend>
